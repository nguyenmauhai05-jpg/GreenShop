APP_NAME=GreenShop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=GreenShop
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=null

CACHE_STORE=file
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Map & shipping (OpenStreetMap/Nominatim + OSRM, không cần API key)
MAP_OSRM_URL=https://router.project-osrm.org
MAP_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
MAP_API_TIMEOUT=8
SHIPPING_FREE_KM=5
SHIPPING_BLOCK_KM=5
SHIPPING_FEE_PER_BLOCK=20000

# GreenShop - thông tin ngân hàng dùng tạo QR chuyển khoản tại checkout
# BANK_ID dùng mã BIN/short name được VietQR hỗ trợ (ví dụ: MBBank, VCB, ACB...)
GREENSHOP_BANK_ID=
GREENSHOP_BANK_ACCOUNT_NO=
GREENSHOP_BANK_ACCOUNT_NAME=
GREENSHOP_VIETQR_TEMPLATE=compact2

# Gemini AI - để trống nếu không dùng tính năng chăm sóc cây bằng AI
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-3-flash-preview

# ONLINE PAYMENT / MOMO
PAYMENT_DEMO_MODE=true
PAYMENT_PENDING_TTL_MINUTES=15

MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_BASE_URL=https://test-payment.momo.vn
MOMO_CREATE_ENDPOINT=/v2/gateway/api/create
MOMO_LANG=vi
MOMO_TIMEOUT=30



# ZaloPay provider (chưa bật trên checkout hiện tại, giữ cho khả năng mở rộng)
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_BASE_URL=https://sb-openapi.zalopay.vn
ZALOPAY_CREATE_ENDPOINT=/v2/create
ZALOPAY_TIMEOUT=30
ZALOPAY_EXPIRE_DURATION_SECONDS=900

# PAYPAL SANDBOX
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_TIMEOUT=30
PAYPAL_CURRENCY=USD
PAYPAL_VND_PER_USD=26000
